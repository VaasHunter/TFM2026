# PLANTILLA. Se copia como /opt/.secrets.env (chmod 600, chown root:root) y se rellena con los valores reales.
# El fichero real (.secrets.env) está en el .gitignore y NUNCA se sube al repositorio.
#
# Este fichero oculto y de acceso restringido, almacena:
#   - Las diferentes APIs utilizadas por los scrapers para el correcto funcionamiento de la búsqueda y extracción del dato
#   - La URL y la API de la plataforma MISP utilizadas por todos los scrapers para ingestar los eventos
#
# No se muestran los datos reales por OPSEC.

MISP_URL="https://localhost"
MISP_API_KEY=""
SHODAN_API=""
OTX_API=""
INCIDENTBUDDY_API=""
VT_API_KEY=""
